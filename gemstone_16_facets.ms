/*  gemopt radial pattern — generated from PatternLayout
    N = 16   sector = 22.50000 deg
    stroke = 0.01000   offset = 90.00000
    Scripting menu -> Run Script.
*/
n = 16
sectorDeg = 22.50000000
offsetDeg = 90.00000000
radius = 50.00000000
stroke = 0.50000000

-- N-sided cylinder: Sides = N, rotated to the same offset as the PNG.
cyl = cylinder radius:radius height:(radius * 0.08) sides:n capstart:on capend:on
cyl.name = "gemopt_ngon"
rotate cyl (angleaxis offsetDeg [0,0,1])

fn gemSpline pts name = (
    local sp = splineShape name:name
    addNewSpline sp
    for p in pts do addKnot sp 1 #corner #line p
    close sp 1
    updateShape sp
    sp
)

gemSpline #([0.00000, 0.00000, 0.00000], [4.90274, 24.64776, 0.00000], [0.00000, 50.00000, 0.00000], [-4.90274, 24.64776, 0.00000]) "wedge_00"
gemSpline #([0.00000, 0.00000, 0.00000], [-4.90274, 24.64776, 0.00000], [-19.13417, 46.19398, 0.00000], [-13.96184, 20.89536, 0.00000]) "wedge_01"
gemSpline #([0.00000, 0.00000, 0.00000], [-13.96184, 20.89536, 0.00000], [-35.35534, 35.35534, 0.00000], [-20.89536, 13.96184, 0.00000]) "wedge_02"
gemSpline #([0.00000, 0.00000, 0.00000], [-20.89536, 13.96184, 0.00000], [-46.19398, 19.13417, 0.00000], [-24.64776, 4.90274, 0.00000]) "wedge_03"
gemSpline #([0.00000, 0.00000, 0.00000], [-24.64776, 4.90274, 0.00000], [-50.00000, 0.00000, 0.00000], [-24.64776, -4.90274, 0.00000]) "wedge_04"
gemSpline #([0.00000, 0.00000, 0.00000], [-24.64776, -4.90274, 0.00000], [-46.19398, -19.13417, 0.00000], [-20.89536, -13.96184, 0.00000]) "wedge_05"
gemSpline #([0.00000, 0.00000, 0.00000], [-20.89536, -13.96184, 0.00000], [-35.35534, -35.35534, 0.00000], [-13.96184, -20.89536, 0.00000]) "wedge_06"
gemSpline #([0.00000, 0.00000, 0.00000], [-13.96184, -20.89536, 0.00000], [-19.13417, -46.19398, 0.00000], [-4.90274, -24.64776, 0.00000]) "wedge_07"
gemSpline #([0.00000, 0.00000, 0.00000], [-4.90274, -24.64776, 0.00000], [-0.00000, -50.00000, 0.00000], [4.90274, -24.64776, 0.00000]) "wedge_08"
gemSpline #([0.00000, 0.00000, 0.00000], [4.90274, -24.64776, 0.00000], [19.13417, -46.19398, 0.00000], [13.96184, -20.89536, 0.00000]) "wedge_09"
gemSpline #([0.00000, 0.00000, 0.00000], [13.96184, -20.89536, 0.00000], [35.35534, -35.35534, 0.00000], [20.89536, -13.96184, 0.00000]) "wedge_10"
gemSpline #([0.00000, 0.00000, 0.00000], [20.89536, -13.96184, 0.00000], [46.19398, -19.13417, 0.00000], [24.64776, -4.90274, 0.00000]) "wedge_11"
gemSpline #([0.00000, 0.00000, 0.00000], [24.64776, -4.90274, 0.00000], [50.00000, -0.00000, 0.00000], [24.64776, 4.90274, 0.00000]) "wedge_12"
gemSpline #([0.00000, 0.00000, 0.00000], [24.64776, 4.90274, 0.00000], [46.19398, 19.13417, 0.00000], [20.89536, 13.96184, 0.00000]) "wedge_13"
gemSpline #([0.00000, 0.00000, 0.00000], [20.89536, 13.96184, 0.00000], [35.35534, 35.35534, 0.00000], [13.96184, 20.89536, 0.00000]) "wedge_14"
gemSpline #([0.00000, 0.00000, 0.00000], [13.96184, 20.89536, 0.00000], [19.13417, 46.19398, 0.00000], [4.90274, 24.64776, 0.00000]) "wedge_15"
gemSpline #([0.00000, 50.00000, 0.00000], [-19.13417, 46.19398, 0.00000], [-35.35534, 35.35534, 0.00000], [-46.19398, 19.13417, 0.00000], [-50.00000, 0.00000, 0.00000], [-46.19398, -19.13417, 0.00000], [-35.35534, -35.35534, 0.00000], [-19.13417, -46.19398, 0.00000], [-0.00000, -50.00000, 0.00000], [19.13417, -46.19398, 0.00000], [35.35534, -35.35534, 0.00000], [46.19398, -19.13417, 0.00000], [50.00000, -0.00000, 0.00000], [46.19398, 19.13417, 0.00000], [35.35534, 35.35534, 0.00000], [19.13417, 46.19398, 0.00000]) "ngon_outline"

c0 = circle radius:8.00000000 name:"halo_00"
c1 = circle radius:14.85714286 name:"halo_01"
c2 = circle radius:21.71428571 name:"halo_02"
c3 = circle radius:28.57142857 name:"halo_03"
c4 = circle radius:35.42857143 name:"halo_04"
